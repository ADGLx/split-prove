// Client-side circuit: proves sk → (pk, nullifier, coinBindingTag).
// The server computes/proves coinCommitment from (coin, pk), so the wallet
// no longer proves the canonical coin commitment locally.
// Server verifies this proof off-chain to confirm the derived values are correct.

import CompactStandardLibrary;

struct ZswapCoinSecretKey {
  bytes: Bytes<32>;
}

struct PublicKeyPreimage {
  sep: Bytes<21>,
  secretKey: ZswapCoinSecretKey,
}

struct NullifierZkfPreimage {
  sep: Field,
  coin: ShieldedCoinInfo,
  secretKey: ZswapCoinSecretKey,
}

struct SplitCoinBindingPreimage {
  sep: Field,
  coin: ShieldedCoinInfo,
  publicKey: ZswapCoinPublicKey,
}

// Public outputs: pk, nullifier, coinBindingTag.
ledger publicKey: ZswapCoinPublicKey;
ledger nullifier: Bytes<32>;
ledger coinBindingTag: Field;

export circuit sk_prove(
  sk: ZswapCoinSecretKey,
  coin: ShieldedCoinInfo
): [] {
  // Derive public key from secret key
  const pk = ZswapCoinPublicKey {
    bytes: persistentHash<PublicKeyPreimage>(PublicKeyPreimage {
      sep: "midnight:zswap-pk[v1]",
      secretKey: sk,
    })
  };
  publicKey = disclose(pk);

  // Compute nullifier with ZK-friendly Poseidon hash. The disclosed type
  // stays Bytes<32> so the node's nullifier set (`Set<Bytes<32>>`) is
  // untouched; upgradeFromTransient zero-pads the Field into 32 bytes.
  const nul = upgradeFromTransient(transientHash<NullifierZkfPreimage>(
    NullifierZkfPreimage {
      sep: "midnight:split-nul[v1]" as Field,
      coin: coin,
      secretKey: sk,
    }));
  nullifier = disclose(nul);

  coinBindingTag = disclose(transientHash<SplitCoinBindingPreimage>(
    SplitCoinBindingPreimage {
      sep: "midnight:zswap-split-coin[v1]" as Field,
      coin: coin,
      publicKey: pk,
    }));
}
