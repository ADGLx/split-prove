// Client-side circuit: proves sk → (pk, coinCom, nullifier)
// This is a real wallet-side proof, not just local hashing. The generated
// artifact currently includes three persistent hashes plus the sk commitment
// and is larger than the split-spend circuit used by the proof server.
// Server verifies this proof off-chain to confirm the derived values are correct.

import CompactStandardLibrary;

struct ZswapCoinSecretKey {
  bytes: Bytes<32>;
}

struct CoinPreimage {
  sep: Bytes<21>,
  info: ShieldedCoinInfo,
  dataType: Boolean,
  data: Bytes<32>,
}

struct PublicKeyPreimage {
  sep: Bytes<21>,
  secretKey: ZswapCoinSecretKey,
}

struct SecretCommitmentPreimage {
  secretKey: ZswapCoinSecretKey,
  blinding: Field,
}

// Public outputs: skCommitment, pk, coinCom, nullifier
// The server uses these as inputs to spend_no_sk
ledger skCommitment: Field;
ledger publicKey: ZswapCoinPublicKey;
ledger coinCommitment: Bytes<32>;
ledger nullifier: Bytes<32>;

export circuit sk_prove(
  sk: ZswapCoinSecretKey,
  skBlinding: Field,
  coin: ShieldedCoinInfo
): [] {
  // Commit to sk without revealing it.
  const skCom = transientHash<SecretCommitmentPreimage>(
    SecretCommitmentPreimage {
      secretKey: sk,
      blinding: skBlinding,
    });
  skCommitment = disclose(skCom);

  // Derive public key from secret key
  const pk = ZswapCoinPublicKey {
    bytes: persistentHash<PublicKeyPreimage>(PublicKeyPreimage {
      sep: "midnight:zswap-pk[v1]",
      secretKey: sk,
    })
  };
  publicKey = disclose(pk);

  // Compute coin commitment (user-owned: dataType=true, data=pk)
  const coinCom = persistentHash<CoinPreimage>(
    CoinPreimage {
      sep: "midnight:zswap-cc[v1]",
      info: coin,
      dataType: true,
      data: pk.bytes,
    });
  coinCommitment = disclose(coinCom);

  // Compute nullifier (user-owned: dataType=true, data=sk)
  const nul = persistentHash<CoinPreimage>(
    CoinPreimage {
      sep: "midnight:zswap-cn[v1]",
      info: coin,
      dataType: true,
      data: sk.bytes,
    });
  nullifier = disclose(nul);
}
