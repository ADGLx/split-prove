// Client-side per-spend circuit, split-prove Solution A.
//
// Replaces the v3 design (which disclosed `pk` and `C_sk` on every split spend,
// trivially linking all spends from a single wallet) with a Merkle-membership
// proof against the wallet registry contract. The wallet stays in the
// anonymity set of all wallets that have ever been registered against any
// historic root of the registry tree.
//
// Per-spend witnesses (all private):
//   * sk           — 32-byte coin secret key
//   * r            — Poseidon blinding for `C_sk` (registered once at setup)
//   * salt         — per-registration blinding for `reg_leaf`
//   * pk           — canonical Zswap public key (constrained against `sk` via
//                    the standard SHA-256 gadget; never disclosed)
//   * coin         — qualified coin info for the spend
//   * merkle_path  — Merkle inclusion proof of `reg_leaf` against some
//                    historical root of the registry tree
//
// Public outputs:
//   * nullifier      — canonical Zswap nullifier
//                      `persistentHash("midnight:zswap-cn[v1]", coin, true, sk)`
//   * coinBindingTag — `transientHash("midnight:zswap-split-coin[v1]", coin, pk)`
//                      (binds this client proof and the server's spend-split
//                       proof to the same `(coin, pk)`)
//   * registryRoot   — root of the registry tree the membership path resolves
//                      to. The admission verifier checks that this root is in
//                      the registry contract's historical root set.
//
// Soundness chain (the four checks that together replace the v3
// attestation/per-spend cross-checks):
//
//   1. `C_sk = transientHash(sep_sk, sk, r)` (Poseidon binding → unique `sk`
//      per `(C_sk, r)`).
//   2. `reg_leaf = transientHash(sep_reg, C_sk, salt)` (Poseidon binding).
//   3. `merkleTreePathRootNoLeafHash(path) == upgradeFromTransient(reg_leaf)`'s
//      historical root → this `reg_leaf` was registered at some point.
//   4. `nullifier = persistentHash(sep_cn, coin, true, sk)` and
//      `coinBindingTag = transientHash(sep_split_coin, coin, pk)` use the same
//      `sk` and `pk` bit witnesses that bound `C_sk` and `pk = H(sk)`.
//
// The canonical `pk = persistentHash("midnight:zswap-pk[v1]", sk)` is computed
// in-circuit (its SHA-256 limbs bind the same `sk` byte witnesses Compact uses
// for the Poseidon `C_sk`), then asserted equal to the witnessed `pk` — and
// never disclosed. Wallet-level unlinkability across split spends comes from
// the membership proof: the only wallet-identifying public output is
// `registryRoot`, which is shared across every contemporaneous spend against
// the same registry state.

import CompactStandardLibrary;

struct ZswapCoinSecretKey {
  bytes: Bytes<32>;
}

struct PublicKeyPreimage {
  sep: Bytes<21>,
  secretKey: ZswapCoinSecretKey,
}

struct SplitCoinBindingPreimage {
  sep: Field,
  coin: ShieldedCoinInfo,
  publicKey: ZswapCoinPublicKey,
}

struct CoinPreimage {
  sep: Bytes<21>,
  info: ShieldedCoinInfo,
  dataType: Boolean,
  data: Bytes<32>,
}

struct SkCommitPreimage {
  sep: Field,
  secretKey: ZswapCoinSecretKey,
  blinding: Field,
}

struct RegLeafPreimage {
  sep: Field,
  commitmentSk: Field,
  salt: Field,
}

// Public outputs: nullifier, coinBindingTag, registryRoot.
ledger nullifier: Bytes<32>;
ledger coinBindingTag: Field;
// Registry-tree root the membership path resolves to. `MerkleTreeDigest`
// matches what `merkleTreePathRootNoLeafHash` returns — a struct wrapping a
// `Field`. The admission verifier reads the digest's field as a `Fr`.
ledger registryRoot: MerkleTreeDigest;

export circuit sk_prove(
  sk: ZswapCoinSecretKey,
  pk: ZswapCoinPublicKey,
  r: Field,
  salt: Field,
  coin: ShieldedCoinInfo,
  merkle_path: MerkleTreePath<20, Bytes<32>>
): [] {
  // 1. Canonical Zswap pk: bind the witnessed `pk` to `sk` via SHA-256. The
  //    pk is NEVER disclosed; this assertion just constrains the same `sk` bit
  //    witnesses that the Poseidon `C_sk` below will consume.
  const pk_canonical = ZswapCoinPublicKey {
    bytes: persistentHash<PublicKeyPreimage>(PublicKeyPreimage {
      sep: "midnight:zswap-pk[v1]",
      secretKey: sk,
    })
  };
  assert(pk_canonical == pk, "witnessed pk must equal H(sk)");

  // 2. Canonical Zswap nullifier — byte-identical to stock so split and
  //    non-split spends of the same coin collide in the same on-ledger
  //    nullifier set.
  nullifier = disclose(persistentHash<CoinPreimage>(
    CoinPreimage {
      sep: "midnight:zswap-cn[v1]",
      info: coin,
      dataType: true,
      data: sk.bytes,
    }));

  // 3. Coin-binding tag — binds this client proof and the server's spend-split
  //    proof to the same `(coin, pk)`. The server's proof discloses the same
  //    value computed from its witnessed `pk`; admission cross-checks the two
  //    discloses for byte-equality.
  coinBindingTag = disclose(transientHash<SplitCoinBindingPreimage>(
    SplitCoinBindingPreimage {
      sep: "midnight:zswap-split-coin[v1]" as Field,
      coin: coin,
      publicKey: pk,
    }));

  // 4. Open the wallet's Poseidon `C_sk` and blind it once more with `salt`
  //    to recompute the registration leaf.
  const commitmentSk = transientHash<SkCommitPreimage>(SkCommitPreimage {
    sep: "midnight:sk-commit[v1]" as Field,
    secretKey: sk,
    blinding: r,
  });
  const regLeaf = transientHash<RegLeafPreimage>(RegLeafPreimage {
    sep: "midnight:wallet-reg[v1]" as Field,
    commitmentSk: commitmentSk,
    salt: salt,
  });

  // 5. Tie the computed `regLeaf` to the supplied Merkle path's leaf, then
  //    compute and disclose the resulting root. The admission verifier checks
  //    this root against the registry contract's HistoricMerkleTree roots set.
  assert(upgradeFromTransient(regLeaf) == merkle_path.leaf,
    "merkle path must be for the computed reg_leaf");
  registryRoot = disclose(merkleTreePathRootNoLeafHash<20>(merkle_path));
}
