// One-time wallet attestation for split-prove (Solution A).
//
// Run once per wallet at setup. Witnesses `(sk, r, salt)` and discloses the
// single field `reg_leaf` that the wallet will then submit to the registry
// contract:
//
//   C_sk     = transientHash("midnight:sk-commit[v1]", sk, r)
//   reg_leaf = transientHash("midnight:wallet-reg[v1]", C_sk, salt)
//
// The canonical Zswap public key `pk = persistentHash("midnight:zswap-pk[v1]",
// sk)` is still computed in-circuit (its SHA-256 limbs bind the same `sk` byte
// witnesses as the Poseidon `C_sk`), but `pk` is NOT disclosed — it is held as
// an in-circuit assertion only. Solution A's chain of soundness:
//
//   1. The per-spend proof opens reg_leaf → C_sk → sk under Poseidon binding.
//   2. The canonical nullifier is `persistentHash(coin, sk)` (stock Zswap).
//   3. Spending a coin requires it to have been minted to `pk = H(sk)`,
//      enforced by stock Zswap's `coinCommitment = H(coin, pk)` and verified
//      in-circuit by the server's `assert(coinCom == path.leaf, …)`.
//   4. Therefore registering reg_leaf for an `sk` you don't own is harmless;
//      you can't spend under it without first receiving a coin minted to its
//      `pk`, and that requires knowing `sk`.
//
// Disclosure compared to the previous v3 attestation circuit:
//   - DROPPED: `publicKey` ledger cell — `pk` is now private to the wallet.
//   - DROPPED: `commitmentSk` ledger cell — `C_sk` is private to the wallet.
//   - ADDED:   `regLeaf` ledger cell — the (blinded) registration leaf.

import CompactStandardLibrary;

struct ZswapCoinSecretKey {
  bytes: Bytes<32>;
}

struct PublicKeyPreimage {
  sep: Bytes<21>,
  secretKey: ZswapCoinSecretKey,
}

struct SkCommitPreimage {
  sep: Field,
  secretKey: ZswapCoinSecretKey,
  blinding: Field,
}

struct RegLeafPreimage {
  sep: Field,
  commitmentSk: Field,
  salt: Field,
}

// Single public output: the registration leaf.
ledger regLeaf: Field;

export circuit wallet_attest(
  sk: ZswapCoinSecretKey,
  r: Field,
  salt: Field
): [] {
  // 1. Bind `sk` bit witnesses through the canonical Zswap pk gadget (SHA-256).
  //    pk is kept private to the wallet; it never leaves the circuit. This
  //    statement still constrains the same bit decomposition Compact reuses
  //    for the Poseidon `C_sk` below, so the two gadgets agree on `sk`.
  const _pk_unused = ZswapCoinPublicKey {
    bytes: persistentHash<PublicKeyPreimage>(PublicKeyPreimage {
      sep: "midnight:zswap-pk[v1]",
      secretKey: sk,
    })
  };

  // 2. Poseidon commitment to `sk`. Binding under Poseidon collision
  //    resistance; hiding under Poseidon preimage resistance and `r`.
  const commitmentSk = transientHash<SkCommitPreimage>(SkCommitPreimage {
    sep: "midnight:sk-commit[v1]" as Field,
    secretKey: sk,
    blinding: r,
  });

  // 3. Blind `C_sk` once more with a per-registration `salt`. The leaf is the
  //    only value disclosed. In principle a fresh independent `salt` would let
  //    a wallet register multiple unlinkable leaves for the same `C_sk`
  //    (unlinkable leaf rotation). NOTE: the PoC derives `(r, salt)`
  //    deterministically from `sk` (see `derive_blinding_pair` in
  //    local_poc_client), so a given wallet always produces the SAME `reg_leaf`
  //    — re-registration is idempotent and leaf rotation is NOT available until
  //    a production wiring derives `salt` from independent entropy.
  regLeaf = disclose(transientHash<RegLeafPreimage>(RegLeafPreimage {
    sep: "midnight:wallet-reg[v1]" as Field,
    commitmentSk: commitmentSk,
    salt: salt,
  }));
}
