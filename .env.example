# Copy this file to .env and fill values locally.
# Never commit the real .env file.

MIDNIGHT_PREVIEW_INDEXER_HTTP=https://indexer.preview.midnight.network/api/v4/graphql
MIDNIGHT_PREVIEW_INDEXER_WS=wss://indexer.preview.midnight.network/api/v4/graphql/ws
MIDNIGHT_PREVIEW_NODE_WS=wss://rpc.preview.midnight.network
MIDNIGHT_PREVIEW_NETWORK_ID=preview

# Keep this secret. Used locally by tools/derive_midnight_zswap_seed.mjs.
MIDNIGHT_PREVIEW_RECOVERY_PHRASE=
MIDNIGHT_PREVIEW_ACCOUNT=0
MIDNIGHT_PREVIEW_ZSWAP_KEY_INDEX=0
MIDNIGHT_PREVIEW_ZSWAP_KEY_SCAN_LIMIT=1
MIDNIGHT_PREVIEW_ZSWAP_EVENT_LIMIT=50000
MIDNIGHT_PREVIEW_REQUEST_TIMEOUT_SECS=120
MIDNIGHT_PREVIEW_SUBMIT_MODE=raw-rpc
MIDNIGHT_PREVIEW_RAW_RPC_SUBMIT_TIMEOUT_SECS=60
MIDNIGHT_PREVIEW_WALLET_SUBMIT_TIMEOUT_SECS=180

# Optional concrete 32-byte zswap seed, hex encoded. If set, tests use this
# directly instead of deriving from MIDNIGHT_PREVIEW_RECOVERY_PHRASE.
MIDNIGHT_PREVIEW_ZSWAP_SEED_HEX=
