# Values for the bundled local-dev chain (deps/midnight-local-dev, option 6).
# The recovery phrase and recipient address below are throwaway test wallets
# only ever used on a local undeployed network — they're safe to commit.
#
# Note: the e2e is local-node only. Public hosted nodes and indexers do not
# run the split-prove POC patches.

# --- Node / indexer / network -------------------------------------------------
MIDNIGHT_LOCAL_NODE_WS=ws://127.0.0.1:9944
MIDNIGHT_LOCAL_INDEXER_HTTP=http://127.0.0.1:8088/api/v4/graphql
MIDNIGHT_LOCAL_INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws
MIDNIGHT_LOCAL_NETWORK_ID=undeployed

# Test wallet that local-dev option 6 funds with a shielded NIGHT output.
MIDNIGHT_LOCAL_RECOVERY_PHRASE="until truly news purchase scorpion trend true media chapter yellow elegant unfold endless frequent wheel mad lake arrange album rather try link curve deposit"

# Recipient for the split-send (another throwaway local-dev address).
MIDNIGHT_LOCAL_RECIPIENT_SHIELDED_ADDRESS=mn_shield-addr_undeployed1yvwkkzgpggxnuuzwrejdr4y7nn5j656gj49lnjwxuffqkkc8xcp2wz4dqcltjsc4z7myp2xm2zmxc965qm63k3cqmyg4ldyfts8txhqmsqhhc

# Image tag produced by `docker build -f deps/midnight-node/Dockerfile.split-prove`.
MIDNIGHT_NODE_IMAGE=midnight-node:split-prove

# Amount sent to the recipient by the split-send e2e, in smallest NIGHT units.
MIDNIGHT_LOCAL_TRANSFER_AMOUNT=200000000

# --- Wallet derivation knobs --------------------------------------------------
MIDNIGHT_LOCAL_ACCOUNT=0
MIDNIGHT_LOCAL_ZSWAP_KEY_INDEX=0
MIDNIGHT_LOCAL_ZSWAP_KEY_SCAN_LIMIT=1
MIDNIGHT_LOCAL_ZSWAP_EVENT_LIMIT=50000

# --- Submission / timeouts ----------------------------------------------------
MIDNIGHT_LOCAL_REQUEST_TIMEOUT_SECS=120
MIDNIGHT_LOCAL_RAW_RPC_SUBMIT_TIMEOUT_SECS=120
MIDNIGHT_LOCAL_RAW_RPC_WAIT_FOR=finalized

# Pre-submit ledger-wasm wellFormed check. Off by default: the registry
# @midnight-ntwrk/ledger-v8 package links the packaged zswap verifier keys and
# rejects locally-modified proofs even when the local node accepts them.
MIDNIGHT_LOCAL_VALIDATE_LEDGER_WASM=

# Optional concrete 32-byte zswap seed, hex encoded. If set, helpers use this
# directly instead of deriving from the recovery phrase. The full split-send
# e2e still requires the recovery phrase for Dust balancing.
MIDNIGHT_LOCAL_ZSWAP_SEED_HEX=
