# Copy this file to .env and fill values locally.
# Never commit the real .env file.

MIDNIGHT_PREVIEW_INDEXER_HTTP=https://indexer.preview.midnight.network/api/v4/graphql
MIDNIGHT_PREVIEW_INDEXER_WS=wss://indexer.preview.midnight.network/api/v4/graphql/ws
MIDNIGHT_PREVIEW_NODE_WS=wss://rpc.preview.midnight.network
MIDNIGHT_PREVIEW_NETWORK_ID=preview

# Keep this secret. Used locally by tools/derive_midnight_zswap_seed.mjs.
MIDNIGHT_PREVIEW_RECOVERY_PHRASE=
MIDNIGHT_PREVIEW_ACCOUNT=0
MIDNIGHT_PREVIEW_ZSWAP_KEY_INDEX=0
MIDNIGHT_PREVIEW_ZSWAP_KEY_SCAN_LIMIT=1
MIDNIGHT_PREVIEW_ZSWAP_EVENT_LIMIT=50000
MIDNIGHT_PREVIEW_RECIPIENT_SHIELDED_ADDRESS=
# Amount sent to the recipient by the split-send e2e, in smallest NIGHT units.
# Defaults to 500 NIGHT.
MIDNIGHT_PREVIEW_TRANSFER_AMOUNT=500000000
MIDNIGHT_PREVIEW_REQUEST_TIMEOUT_SECS=120
MIDNIGHT_PREVIEW_WALLET_SUBMIT_MODE=raw-rpc
MIDNIGHT_PREVIEW_RAW_RPC_SUBMIT_TIMEOUT_SECS=120
MIDNIGHT_PREVIEW_RAW_RPC_WAIT_FOR=inBlock
MIDNIGHT_PREVIEW_WALLET_SUBMIT_TIMEOUT_SECS=180
# Set to 1 to run a pre-submit ledger-wasm wellFormed check. Off by default
# because the registry @midnight-ntwrk/ledger-v8 package is built against
# packaged zswap verifier keys; it will reject locally-modified proofs even when
# the local node accepts them. Enable only when the wasm package matches the
# node's ledger code.
MIDNIGHT_PREVIEW_VALIDATE_LEDGER_WASM=

# Optional concrete 32-byte zswap seed, hex encoded. If set, tests use this
# directly instead of deriving from MIDNIGHT_PREVIEW_RECOVERY_PHRASE for
# prove-only helper paths. The full split-send e2e requires the recovery phrase
# for Dust balancing and submission.
MIDNIGHT_PREVIEW_ZSWAP_SEED_HEX=
